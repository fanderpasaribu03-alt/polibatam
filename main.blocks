<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="dEMP!hf79*^1g^`Lf[JZ" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="f;Iv:IN4GA_:0C9pL|I,"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyMotor {" line1="    //% block=&quot;kiri&quot;" line2="    Left," line3="    //% block=&quot;kanan&quot;" line4="    Right" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="ZEdAIKRt$GvU0JEW/(TP"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyDirection {" line1="    //% block=&quot;maju&quot;" line2="    Forward," line3="    //% block=&quot;mundur&quot;" line4="    Backward" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="vyeYAYtsUnayc+*T,Sp^"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum RgbColor {" line1="    //% block=&quot;merah&quot;" line2="    Red," line3="    //% block=&quot;hijau&quot;" line4="    Green," line5="    //% block=&quot;biru&quot;" line6="    Blue," line7="    //% block=&quot;kuning&quot;" line8="    Yellow," line9="    //% block=&quot;ungu&quot;" line10="    Purple," line11="    //% block=&quot;putih&quot;" line12="    White," line13="    //% block=&quot;mati&quot;" line14="    Off" line15="}" numlines="16"></mutation><next><block type="typescript_statement" id="]^z.iy;wFWU=dno(YS0:"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace myRobotPlus {" line1="" line2="    // ---------- NILAI DEFAULT (bisa diubah lewat block &quot;atur pin...&quot;) ----------" line3="    let pinMotorKiri = AnalogPin.P0" line4="    let pinMotorKanan = AnalogPin.P1" line5="    let pinArahKiri = DigitalPin.P8" line6="    let pinArahKanan = DigitalPin.P12" line7="    let pinTrig = DigitalPin.P13" line8="    let pinEcho = DigitalPin.P14" line9="    let pinLineKiri = DigitalPin.P15" line10="    let pinLineKanan = DigitalPin.P16" line11="    let pinBuzzer = AnalogPin.P2" line12="    let pinLedR = AnalogPin.P3" line13="    let pinLedG = AnalogPin.P4" line14="    let pinLedB = AnalogPin.P10" line15="" line16="    // ================= PENGATURAN PIN =================" line17="    /**" line18="     * Atur pin buat motor kiri (pin kecepatan &amp; pin arah)" line19="     */" line20="    //% block=&quot;atur pin motor kiri: kecepatan %speedPin arah %dirPin&quot;" line21="    //% group=&quot;Pengaturan Pin&quot;" line22="    //% weight=100" line23="    export function aturPinMotorKiri(speedPin: AnalogPin, dirPin: DigitalPin): void {" line24="        pinMotorKiri = speedPin" line25="        pinArahKiri = dirPin" line26="    }" line27="" line28="    /**" line29="     * Atur pin buat motor kanan (pin kecepatan &amp; pin arah)" line30="     */" line31="    //% block=&quot;atur pin motor kanan: kecepatan %speedPin arah %dirPin&quot;" line32="    //% group=&quot;Pengaturan Pin&quot;" line33="    //% weight=99" line34="    export function aturPinMotorKanan(speedPin: AnalogPin, dirPin: DigitalPin): void {" line35="        pinMotorKanan = speedPin" line36="        pinArahKanan = dirPin" line37="    }" line38="" line39="    /**" line40="     * Atur pin buat sensor ultrasonic (trig &amp; echo)" line41="     */" line42="    //% block=&quot;atur pin ultrasonic: trig %trig echo %echo&quot;" line43="    //% group=&quot;Pengaturan Pin&quot;" line44="    //% weight=98" line45="    export function aturPinUltrasonic(trig: DigitalPin, echo: DigitalPin): void {" line46="        pinTrig = trig" line47="        pinEcho = echo" line48="    }" line49="" line50="    /**" line51="     * Atur pin buat sensor line-tracking kiri &amp; kanan" line52="     */" line53="    //% block=&quot;atur pin sensor garis: kiri %kiri kanan %kanan&quot;" line54="    //% group=&quot;Pengaturan Pin&quot;" line55="    //% weight=97" line56="    export function aturPinLineTracking(kiri: DigitalPin, kanan: DigitalPin): void {" line57="        pinLineKiri = kiri" line58="        pinLineKanan = kanan" line59="    }" line60="" line61="    /**" line62="     * Atur pin buzzer" line63="     */" line64="    //% block=&quot;atur pin buzzer %pin&quot;" line65="    //% group=&quot;Pengaturan Pin&quot;" line66="    //% weight=96" line67="    export function aturPinBuzzer(pin: AnalogPin): void {" line68="        pinBuzzer = pin" line69="    }" line70="" line71="    /**" line72="     * Atur pin LED RGB (3 kaki terpisah: merah, hijau, biru)" line73="     */" line74="    //% block=&quot;atur pin LED RGB: merah %r hijau %g biru %b&quot;" line75="    //% group=&quot;Pengaturan Pin&quot;" line76="    //% weight=95" line77="    export function aturPinLED(r: AnalogPin, g: AnalogPin, b: AnalogPin): void {" line78="        pinLedR = r" line79="        pinLedG = g" line80="        pinLedB = b" line81="    }" line82="" line83="    // ================= MOTOR =================" line84="    /**" line85="     * Menggerakkan motor tertentu dengan arah dan kecepatan" line86="     */" line87="    //% block=&quot;gerakkan motor %motor arah %direction kecepatan %speed&quot;" line88="    //% speed.min=0 speed.max=100" line89="    //% group=&quot;Motor&quot;" line90="    //% weight=100" line91="    export function gerakMotor(motor: MyMotor, direction: MyDirection, speed: number): void {" line92="        let pwm = Math.map(speed, 0, 100, 0, 1023)" line93="        let arahPin = motor == MyMotor.Left ? pinArahKiri : pinArahKanan" line94="        let speedPin = motor == MyMotor.Left ? pinMotorKiri : pinMotorKanan" line95="" line96="        pins.digitalWritePin(arahPin, direction == MyDirection.Forward ? 1 : 0)" line97="        pins.analogWritePin(speedPin, pwm)" line98="    }" line99="" line100="    /**" line101="     * Menghentikan motor tertentu" line102="     */" line103="    //% block=&quot;hentikan motor %motor&quot;" line104="    //% group=&quot;Motor&quot;" line105="    //% weight=90" line106="    export function stopMotor(motor: MyMotor): void {" line107="        let speedPin2 = motor == MyMotor.Left ? pinMotorKiri : pinMotorKanan" line108="        pins.analogWritePin(speedPin2, 0)" line109="    }" line110="" line111="    /**" line112="     * Menghentikan semua motor sekaligus" line113="     */" line114="    //% block=&quot;hentikan semua motor&quot;" line115="    //% group=&quot;Motor&quot;" line116="    //% weight=80" line117="    export function stopSemuaMotor(): void {" line118="        pins.analogWritePin(pinMotorKiri, 0)" line119="        pins.analogWritePin(pinMotorKanan, 0)" line120="    }" line121="" line122="    // ================= ULTRASONIC =================" line123="    /**" line124="     * Membaca jarak dari sensor ultrasonic (dalam cm)" line125="     */" line126="    //% block=&quot;baca jarak (cm)&quot;" line127="    //% group=&quot;Ultrasonic&quot;" line128="    //% weight=100" line129="    export function bacaJarak(): number {" line130="        pins.digitalWritePin(pinTrig, 0)" line131="        control.waitMicros(2)" line132="        pins.digitalWritePin(pinTrig, 1)" line133="        control.waitMicros(10)" line134="        pins.digitalWritePin(pinTrig, 0)" line135="" line136="        let durasi = pins.pulseIn(pinEcho, PulseValue.High, 25000)" line137="        let jarak = durasi * 0.034 / 2" line138="        return Math.round(jarak)" line139="    }" line140="" line141="    // ================= LINE TRACKING =================" line142="    /**" line143="     * Membaca status sensor line-tracking kiri (true = kena garis)" line144="     */" line145="    //% block=&quot;sensor garis kiri terdeteksi&quot;" line146="    //% group=&quot;Line Tracking&quot;" line147="    //% weight=100" line148="    export function sensorGarisKiri(): boolean {" line149="        return pins.digitalReadPin(pinLineKiri) == 1" line150="    }" line151="" line152="    /**" line153="     * Membaca status sensor line-tracking kanan (true = kena garis)" line154="     */" line155="    //% block=&quot;sensor garis kanan terdeteksi&quot;" line156="    //% group=&quot;Line Tracking&quot;" line157="    //% weight=90" line158="    export function sensorGarisKanan(): boolean {" line159="        return pins.digitalReadPin(pinLineKanan) == 1" line160="    }" line161="" line162="    // ================= LED RGB =================" line163="    /**" line164="     * Menyalakan LED RGB dengan warna tertentu (LED RGB 3 kaki, dikontrol lewat PWM)" line165="     */" line166="    //% block=&quot;nyalakan LED warna %color&quot;" line167="    //% group=&quot;LED&quot;" line168="    //% weight=100" line169="    export function nyalakanLED(color: RgbColor): void {" line170="        let r = 0, g = 0, b = 0" line171="        switch (color) {" line172="            case RgbColor.Red: r = 1023; g = 0; b = 0; break" line173="            case RgbColor.Green: r = 0; g = 1023; b = 0; break" line174="            case RgbColor.Blue: r = 0; g = 0; b = 1023; break" line175="            case RgbColor.Yellow: r = 1023; g = 1023; b = 0; break" line176="            case RgbColor.Purple: r = 1023; g = 0; b = 1023; break" line177="            case RgbColor.White: r = 1023; g = 1023; b = 1023; break" line178="            case RgbColor.Off: r = 0; g = 0; b = 0; break" line179="        }" line180="        pins.analogWritePin(pinLedR, r)" line181="        pins.analogWritePin(pinLedG, g)" line182="        pins.analogWritePin(pinLedB, b)" line183="        basic.showNumber(r)   " line184="    }" line185="" line186="    // ================= BUZZER =================" line187="    /**" line188="     * Membunyikan buzzer dengan frekuensi tertentu selama X ms" line189="     */" line190="    //% block=&quot;bunyikan buzzer frekuensi %freq selama %durasi ms&quot;" line191="    //% freq.min=100 freq.max=5000 durasi.min=100 durasi.max=5000" line192="    //% group=&quot;Buzzer&quot;" line193="    //% weight=100" line194="    export function bunyikanBuzzer(freq: number, durasi: number): void {" line195="        pins.analogSetPitchPin(pinBuzzer)" line196="        music.playTone(freq, durasi)" line197="    }" line198="}" numlines="199"></mutation></block></next></block></next></block></next></block></statement></block><block type="myRobotPlus_gerakMotor" id="Ce`)OUVE}VTg5!8A)tD?" disabled-reasons="pxt_automatic_disabled" x="895" y="0"><field name="motor">MyMotor.Left</field><field name="direction">MyDirection.Forward</field><value name="speed"><shadow type="math_number_minmax" id="(WPyE):G[`%Y7=Lp`aZ-" disabled-reasons="pxt_automatic_disabled"><mutation min="0" max="100" label="Speed" precision="0"></mutation><field name="SLIDER">0</field></shadow></value></block><block type="device_forever" id="Q}de_Y!TqJ#hUyj77X~|" x="13" y="9243"><statement name="HANDLER"><block type="myRobotPlus_nyalakanLED" id="8BhtX#r{zu%{ZOfS?SA|"><field name="color">RgbColor.Blue</field></block></statement></block></xml>