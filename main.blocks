<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="myRobotPlus_gerakMotor" id="u!_1(y4Ywz-;2TTNE=WB" disabled-reasons="pxt_automatic_disabled" x="604" y="-575"><field name="motor">MyMotor.Left</field><field name="direction">MyDirection.Forward</field><value name="speed"><shadow type="math_number_minmax" id="2$iMUeoG:ESpN2TR4ma+" disabled-reasons="pxt_automatic_disabled"><mutation min="0" max="100" label="Speed" precision="0"></mutation><field name="SLIDER">0</field></shadow></value></block><block type="pxt-on-start" id=":5eAU#Za}~{q?iv8g~6G" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="suC_1?tJUt:aEG}]4,vG"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyMotor {" line1="    //% block=&quot;kiri&quot;" line2="    Left," line3="    //% block=&quot;kanan&quot;" line4="    Right" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="DGs?i3%kQ8KPQ!{`*4)|"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyDirection {" line1="    //% block=&quot;maju&quot;" line2="    Forward," line3="    //% block=&quot;mundur&quot;" line4="    Backward" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="213v2tx75pVRC={ey)gb"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum RgbColor {" line1="    //% block=&quot;merah&quot;" line2="    Red," line3="    //% block=&quot;hijau&quot;" line4="    Green," line5="    //% block=&quot;biru&quot;" line6="    Blue," line7="    //% block=&quot;mati&quot;" line8="    Off" line9="}" numlines="10"></mutation><next><block type="typescript_statement" id="rB]Pd.t8rUhNLB?]Lu_n"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace myRobotPlus {" line1="" line2="    // ---------- KONFIGURASI PIN (SESUAIKAN!) ----------" line3="    const PIN_MOTOR_KIRI = AnalogPin.P0" line4="    const PIN_MOTOR_KANAN = AnalogPin.P1" line5="    const PIN_ARAH_KIRI = DigitalPin.P8" line6="    const PIN_ARAH_KANAN = DigitalPin.P12" line7="    const PIN_TRIG = DigitalPin.P13" line8="    const PIN_ECHO = DigitalPin.P14" line9="    const PIN_LINE_KIRI = DigitalPin.P15" line10="    const PIN_LINE_KANAN = DigitalPin.P16" line11="    const PIN_BUZZER = AnalogPin.P2" line12="" line13="    // ================= MOTOR =================" line14="    /**" line15="     * Menggerakkan motor tertentu dengan arah dan kecepatan" line16="     */" line17="    //% block=&quot;gerakkan motor %motor arah %direction kecepatan %speed&quot;" line18="    //% speed.min=0 speed.max=100" line19="    //% group=&quot;Motor&quot;" line20="    //% weight=100" line21="    export function gerakMotor(motor: MyMotor, direction: MyDirection, speed: number): void {" line22="        let pwm = Math.map(speed, 0, 100, 0, 1023)" line23="        let arahPin = motor == MyMotor.Left ? PIN_ARAH_KIRI : PIN_ARAH_KANAN" line24="        let speedPin = motor == MyMotor.Left ? PIN_MOTOR_KIRI : PIN_MOTOR_KANAN" line25="" line26="        pins.digitalWritePin(arahPin, direction == MyDirection.Forward ? 1 : 0)" line27="        pins.analogWritePin(speedPin, pwm)" line28="    }" line29="" line30="    /**" line31="     * Menghentikan motor tertentu" line32="     */" line33="    //% block=&quot;hentikan motor %motor&quot;" line34="    //% group=&quot;Motor&quot;" line35="    //% weight=90" line36="    export function stopMotor(motor: MyMotor): void {" line37="        let speedPin2 = motor == MyMotor.Left ? PIN_MOTOR_KIRI : PIN_MOTOR_KANAN" line38="        pins.analogWritePin(speedPin2, 0)" line39="    }" line40="" line41="    /**" line42="     * Menghentikan semua motor sekaligus" line43="     */" line44="    //% block=&quot;hentikan semua motor&quot;" line45="    //% group=&quot;Motor&quot;" line46="    //% weight=80" line47="    export function stopSemuaMotor(): void {" line48="        pins.analogWritePin(PIN_MOTOR_KIRI, 0)" line49="        pins.analogWritePin(PIN_MOTOR_KANAN, 0)" line50="    }" line51="" line52="    // ================= ULTRASONIC =================" line53="    /**" line54="     * Membaca jarak dari sensor ultrasonic (dalam cm)" line55="     */" line56="    //% block=&quot;baca jarak (cm)&quot;" line57="    //% group=&quot;Ultrasonic&quot;" line58="    //% weight=100" line59="    export function bacaJarak(): number {" line60="        pins.digitalWritePin(PIN_TRIG, 0)" line61="        control.waitMicros(2)" line62="        pins.digitalWritePin(PIN_TRIG, 1)" line63="        control.waitMicros(10)" line64="        pins.digitalWritePin(PIN_TRIG, 0)" line65="" line66="        let durasi = pins.pulseIn(PIN_ECHO, PulseValue.High, 25000)" line67="        let jarak = durasi * 0.034 / 2" line68="        return Math.round(jarak)" line69="    }" line70="" line71="    // ================= LINE TRACKING =================" line72="    /**" line73="     * Membaca status sensor line-tracking kiri (true = kena garis)" line74="     */" line75="    //% block=&quot;sensor garis kiri terdeteksi&quot;" line76="    //% group=&quot;Line Tracking&quot;" line77="    //% weight=100" line78="    export function sensorGarisKiri(): boolean {" line79="        return pins.digitalReadPin(PIN_LINE_KIRI) == 1" line80="    }" line81="" line82="    /**" line83="     * Membaca status sensor line-tracking kanan (true = kena garis)" line84="     */" line85="    //% block=&quot;sensor garis kanan terdeteksi&quot;" line86="    //% group=&quot;Line Tracking&quot;" line87="    //% weight=90" line88="    export function sensorGarisKanan(): boolean {" line89="        return pins.digitalReadPin(PIN_LINE_KANAN) == 1" line90="    }" line91="" line92="    // ================= LED RGB =================" line93="    /**" line94="     * Menyalakan LED RGB dengan warna tertentu" line95="     * (Catatan: ini contoh dasar, sesuaikan kalau LED kamu pakai chip seperti WS2812/Neopixel)" line96="     */" line97="    //% block=&quot;nyalakan LED warna %color&quot;" line98="    //% group=&quot;LED&quot;" line99="    //% weight=100" line100="    export function nyalakanLED(color: RgbColor): void {" line101="        // Contoh sederhana - sesuaikan dengan wiring LED kamu" line102="        basic.showIcon(IconNames.Yes)" line103="    }" line104="" line105="    // ================= BUZZER =================" line106="    /**" line107="     * Membunyikan buzzer dengan frekuensi tertentu selama X ms" line108="     */" line109="    //% block=&quot;bunyikan buzzer frekuensi %freq selama %durasi ms&quot;" line110="    //% freq.min=100 freq.max=5000 durasi.min=100 durasi.max=5000" line111="    //% group=&quot;Buzzer&quot;" line112="    //% weight=100" line113="    export function bunyikanBuzzer(freq: number, durasi: number): void {" line114="        pins.analogSetPitchPin(PIN_BUZZER)" line115="        music.playTone(freq, durasi)" line116="    }" line117="}" numlines="118"></mutation></block></next></block></next></block></next></block></statement></block></xml>