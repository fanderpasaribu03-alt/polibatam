<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="`P0CLt!iEC./WRkXt57F" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="E|SDT]%Kap6eRW]TpNNw"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyMotor {" line1="    //% block=&quot;kiri&quot;" line2="    Left," line3="    //% block=&quot;kanan&quot;" line4="    Right" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="-Me}hy/$6Zy7rb8}6=hU"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MyDirection {" line1="    //% block=&quot;maju&quot;" line2="    Forward," line3="    //% block=&quot;mundur&quot;" line4="    Backward" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="Qqeb;~p4l3l:3xq8[1E?"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum RgbColor {" line1="    //% block=&quot;merah&quot;" line2="    Red," line3="    //% block=&quot;hijau&quot;" line4="    Green," line5="    //% block=&quot;biru&quot;" line6="    Blue," line7="    //% block=&quot;mati&quot;" line8="    Off" line9="}" numlines="10"></mutation><next><block type="typescript_statement" id="nB}FE1rMR/Rv,_ZY_P]f"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace myRobotPlus {" line1="" line2="    // ---------- KONFIGURASI PIN (SESUAIKAN!) ----------" line3="    const PIN_MOTOR_KIRI = AnalogPin.P0" line4="    const PIN_MOTOR_KANAN = AnalogPin.P1" line5="    const PIN_ARAH_KIRI = DigitalPin.P8" line6="    const PIN_ARAH_KANAN = DigitalPin.P12" line7="    const PIN_TRIG = DigitalPin.P13" line8="    const PIN_ECHO = DigitalPin.P14" line9="    const PIN_LINE_KIRI = DigitalPin.P15" line10="    const PIN_LINE_KANAN = DigitalPin.P16" line11="    const PIN_BUZZER = AnalogPin.P2" line12="" line13="    // ================= MOTOR =================" line14="    /**" line15="     * Menggerakkan motor tertentu dengan arah dan kecepatan" line16="     */" line17="    //% block=&quot;gerakkan motor %motor arah %direction kecepatan %speed&quot;" line18="    //% speed.min=0 speed.max=100" line19="    export function gerakMotor(motor: MyMotor, direction: MyDirection, speed: number): void {" line20="        let pwm = Math.map(speed, 0, 100, 0, 1023)" line21="        let arahPin = motor == MyMotor.Left ? PIN_ARAH_KIRI : PIN_ARAH_KANAN" line22="        let speedPin = motor == MyMotor.Left ? PIN_MOTOR_KIRI : PIN_MOTOR_KANAN" line23="" line24="        pins.digitalWritePin(arahPin, direction == MyDirection.Forward ? 1 : 0)" line25="        pins.analogWritePin(speedPin, pwm)" line26="    }" line27="" line28="    /**" line29="     * Menghentikan motor tertentu" line30="     */" line31="    //% block=&quot;hentikan motor %motor&quot;" line32="    export function stopMotor(motor: MyMotor): void {" line33="        let speedPin2 = motor == MyMotor.Left ? PIN_MOTOR_KIRI : PIN_MOTOR_KANAN" line34="        pins.analogWritePin(speedPin2, 0)" line35="    }" line36="" line37="    /**" line38="     * Menghentikan semua motor sekaligus" line39="     */" line40="    //% block=&quot;hentikan semua motor&quot;" line41="    export function stopSemuaMotor(): void {" line42="        pins.analogWritePin(PIN_MOTOR_KIRI, 0)" line43="        pins.analogWritePin(PIN_MOTOR_KANAN, 0)" line44="    }" line45="" line46="    // ================= ULTRASONIC =================" line47="    /**" line48="     * Membaca jarak dari sensor ultrasonic (dalam cm)" line49="     */" line50="    //% block=&quot;baca jarak (cm)&quot;" line51="    export function bacaJarak(): number {" line52="        pins.digitalWritePin(PIN_TRIG, 0)" line53="        control.waitMicros(2)" line54="        pins.digitalWritePin(PIN_TRIG, 1)" line55="        control.waitMicros(10)" line56="        pins.digitalWritePin(PIN_TRIG, 0)" line57="" line58="        let durasi = pins.pulseIn(PIN_ECHO, PulseValue.High, 25000)" line59="        let jarak = durasi * 0.034 / 2" line60="        return Math.round(jarak)" line61="    }" line62="" line63="    // ================= LINE TRACKING =================" line64="    /**" line65="     * Membaca status sensor line-tracking kiri (true = kena garis)" line66="     */" line67="    //% block=&quot;sensor garis kiri terdeteksi&quot;" line68="    export function sensorGarisKiri(): boolean {" line69="        return pins.digitalReadPin(PIN_LINE_KIRI) == 1" line70="    }" line71="" line72="    /**" line73="     * Membaca status sensor line-tracking kanan (true = kena garis)" line74="     */" line75="    //% block=&quot;sensor garis kanan terdeteksi&quot;" line76="    export function sensorGarisKanan(): boolean {" line77="        return pins.digitalReadPin(PIN_LINE_KANAN) == 1" line78="    }" line79="" line80="    // ================= LED RGB =================" line81="    /**" line82="     * Menyalakan LED RGB dengan warna tertentu" line83="     * (Catatan: ini contoh dasar pakai 3 pin R-G-B terpisah," line84="     * sesuaikan kalau LED kamu pakai chip seperti WS2812/Neopixel)" line85="     */" line86="    //% block=&quot;nyalakan LED warna %color&quot;" line87="    export function nyalakanLED(color: RgbColor): void {" line88="        // Contoh sederhana - sesuaikan dengan wiring LED kamu" line89="        basic.showIcon(IconNames.Yes)" line90="    }" line91="" line92="    // ================= BUZZER =================" line93="    /**" line94="     * Membunyikan buzzer dengan frekuensi tertentu selama X ms" line95="     */" line96="    //% block=&quot;bunyikan buzzer frekuensi %freq selama %durasi ms&quot;" line97="    //% freq.min=100 freq.max=5000 durasi.min=100 durasi.max=5000" line98="    export function bunyikanBuzzer(freq: number, durasi: number): void {" line99="        pins.analogSetPitchPin(PIN_BUZZER)" line100="        music.playTone(freq, durasi)" line101="    }" line102="}" numlines="103"></mutation></block></next></block></next></block></next></block></statement></block></xml>